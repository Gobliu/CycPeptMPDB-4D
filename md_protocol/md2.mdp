constraints = h-bonds 
integrator = md
dt = 0.002 
nsteps = 1000000 

nstxout = 0 ; 
nstxtcout = 50000
nstvout = 0
nstfout = 0
nstlog = 50000
nstenergy = 50000
nstlist = 5
ns_type = grid
rlist = 1.0 
coulombtype = PME 
rcoulomb = 1.0 
rvdw = 1.0
fourierspacing = 0.12
pme_order = 4
ewald_rtol = 1e-5
optimize_fft = yes
Tcoupl = Nose-Hoover 
tc-grps = system 
tau_t = 0.5           
ref_t = 300   
pcoupl          = C-rescale 
pcoupltype      = isotropic       
tau_p           = 1.0            
ref_p           = 1.0           
compressibility = 4.5e-5
gen_vel = no 
gen_temp = 300.0
gen_seed = 173529
nstcomm         = 5 
comm-mode       = Linear
cutoff-scheme = Verlet
DispCorr = EnerPres

