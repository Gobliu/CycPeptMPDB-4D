# Ignore macOS files
.DS_Store

# Ignore Python bytecode
__pycache__/
*.pyc

# Ignore NSCC related files
out-run.txt
jobsub.sh

# Ignore preprocessed data and trained model
*.pkl
*.pth
*.p
*.pt

# Explicitly allow data analysis data
!pts/*.pt

# Bulk per-peptide data belongs in the sibling Data/ dir, not the repo
avg_pairwise_rmsd/

# Source-publication PDF (copyright) and scratch image
cycpeptmpdb-a-comprehensive-database-of-membrane-permeability-of-cyclic-peptides.pdf
Untitled.jpeg
# Excel lock/temp files
~$*.xlsx

# regenerable OmegaComputer backbone logs
logs/Irregular_Backbone_*.txt

# training model checkpoints (train_se3.py output)
checkpoints/

# Editor / tool config (personal, machine-specific)
.claude/
.vscode/
